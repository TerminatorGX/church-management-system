// Church Management System with CRM capabilities
// Scope: auth + roles, member/family CRM, attendance, contributions ledger,
// volunteer scheduling, dashboard analytics, AI assistant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  FINANCE
  DEPT_HEAD
  VIEWER
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  WIDOWED
  DIVORCED
  UNSPECIFIED
}

enum EventType {
  SUNDAY_SERVICE
  MIDWEEK_SERVICE
  SMALL_GROUP
  SPECIAL_EVENT
  OUTREACH
  CONFERENCE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CHEQUE
  IN_KIND
}

enum AssignmentStatus {
  PENDING
  CONFIRMED
  DECLINED
  COMPLETED
  CANCELLED
}

enum MessageRole {
  USER
  ASSISTANT
}

// ---------------------------------------------------------------------------
// Auth & access control
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(VIEWER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  // A login account may optionally be linked to a congregation member record.
  memberId String? @unique
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  // A DEPT_HEAD's permissions are scoped to the departments they lead.
  ledDepartments Department[] @relation("DepartmentLeader")

  createdEvents        Event[]               @relation("EventCreatedBy")
  recordedContributions Contribution[]       @relation("ContributionRecordedBy")
  recordedAttendance   Attendance[]          @relation("AttendanceRecordedBy")
  createdAssignments   VolunteerAssignment[] @relation("AssignmentCreatedBy")
  conversations        Conversation[]
  auditLogs            AuditLog[]
  passwordResetTokens  PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

/// Self-service "forgot password" tokens. The raw token is emailed to the
/// user and never stored — only its hash — so a database read alone can't
/// be used to take over an account.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Append-only trail of who changed what. Required by the data-protection
/// section of the proposal.
model AuditLog {
  id       String  @id @default(uuid())
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  action   String // CREATE | UPDATE | DELETE | LOGIN | EXPORT
  entity   String // Member, Contribution, ...
  entityId String?
  summary  String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Member / family CRM
// ---------------------------------------------------------------------------

model Family {
  id         String  @id @default(uuid())
  familyName String
  address    String?
  city       String?
  phone      String?
  notes      String?

  members Member[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyName])
}

model Member {
  id            String         @id @default(uuid())
  firstName     String
  lastName      String
  email         String?
  phone         String?
  dateOfBirth   DateTime?      @db.Date
  gender        Gender         @default(UNSPECIFIED)
  maritalStatus MaritalStatus  @default(UNSPECIFIED)
  baptismDate   DateTime?      @db.Date
  joinedDate    DateTime?      @db.Date
  address       String?
  city          String?
  occupation    String?
  notes         String?
  isActive      Boolean        @default(true)

  /// CRM: free-form skills and interests used for volunteer matching.
  skills    String[] @default([])
  interests String[] @default([])

  familyId String?
  family   Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  /// Set when this member is the head of their household.
  isFamilyHead Boolean @default(false)

  user                 User?
  departmentMemberships DepartmentMember[]
  contributions        Contribution[]
  attendances          Attendance[]
  volunteerAssignments VolunteerAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName])
  @@index([isActive])
  @@index([familyId])
}

model Department {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  leaderId String?
  leader   User?   @relation("DepartmentLeader", fields: [leaderId], references: [id], onDelete: SetNull)

  members DepartmentMember[]
  events  Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DepartmentMember {
  id           String    @id @default(uuid())
  memberId     String
  member       Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  roleTitle    String? // e.g. "Choir lead", "Sunday school teacher"
  startDate    DateTime  @default(now()) @db.Date
  endDate      DateTime? @db.Date
  isActive     Boolean   @default(true)

  createdAt DateTime @default(now())

  @@unique([memberId, departmentId])
  @@index([departmentId, isActive])
}

// ---------------------------------------------------------------------------
// Events & attendance
// ---------------------------------------------------------------------------

model Event {
  id          String    @id @default(uuid())
  name        String
  type        EventType @default(SUNDAY_SERVICE)
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  description String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  attendances Attendance[]
  assignments VolunteerAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
  @@index([type, startsAt])
}

model Attendance {
  id       String           @id @default(uuid())
  memberId String
  member   Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  eventId  String
  event    Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status   AttendanceStatus @default(PRESENT)
  note     String?

  recordedById String?
  recordedBy   User?   @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One attendance row per member per event — prevents double check-in.
  @@unique([memberId, eventId])
  @@index([eventId, status])
  @@index([memberId])
}

// ---------------------------------------------------------------------------
// Contributions ledger (no payment gateway — recording only)
// ---------------------------------------------------------------------------

model Fund {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  contributions Contribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contribution {
  id     String  @id @default(uuid())
  /// Money is never a Float. 12 digits total, 2 after the decimal point.
  amount Decimal @db.Decimal(12, 2)

  currency      String        @default("ZMW")
  receivedOn    DateTime      @db.Date
  paymentMethod PaymentMethod @default(CASH)
  receiptNumber String        @unique
  notes         String?

  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Restrict)

  /// Nullable so anonymous / loose-offering giving can still be recorded.
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  recordedById String?
  recordedBy   User?   @relation("ContributionRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receivedOn])
  @@index([fundId, receivedOn])
  @@index([memberId, receivedOn])
}

// ---------------------------------------------------------------------------
// Volunteer scheduling
// ---------------------------------------------------------------------------

model VolunteerRole {
  id          String  @id @default(uuid())
  name        String  @unique // Usher, Worship, Children's ministry, Sound...
  description String?
  isActive    Boolean @default(true)

  assignments VolunteerAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VolunteerAssignment {
  id       String           @id @default(uuid())
  memberId String
  member   Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  eventId  String
  event    Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roleId   String
  role     VolunteerRole    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status   AssignmentStatus @default(PENDING)
  notes    String?

  /// Recorded after the event so leaders can report on service hours.
  serviceHours Decimal? @db.Decimal(5, 2)

  createdById String?
  createdBy   User?   @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A member fills a given role on a given event at most once.
  @@unique([memberId, eventId, roleId])
  @@index([eventId, status])
  @@index([memberId])
}

// ---------------------------------------------------------------------------
// AI assistant
// ---------------------------------------------------------------------------

model Conversation {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String @default("New conversation")

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String

  /// Names of the data tools the assistant invoked to answer, for transparency.
  toolsUsed String[] @default([])

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}
